<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>3D Crazy Taxi - Version Clients</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: sans-serif; background: #111; }
        #ui { position: absolute; top: 20px; left: 20px; color: white; font-size: 24px; font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); pointer-events: none; }
        #gameover { display: none; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #ff3333; font-size: 48px; font-weight: bold; text-align: center; text-shadow: 3px 3px 6px rgba(0,0,0,0.9); }
        #restart { font-size: 20px; margin-top: 20px; padding: 10px 20px; background: #ffcc00; color: black; border: none; cursor: pointer; font-weight: bold; border-radius: 5px; }
    </style>
    <!-- Importation de Three.js -->
    <script src="https://cloudflare.com"></script>
</head>
<body>

    <div id="ui">SCORE: <span id="score">0</span></div>
    <div id="gameover">
        CRASH !<br>
        <button id="restart" onclick="resetGame()">REJOUER</button>
    </div>

    <script>
        let scene, camera, renderer;
        let taxi, road, road2;
        let obstacles = [];
        let customers = [];
        let score = 0;
        let speed = 0.8;
        let gameOver = false;
        let targetLane = 0; // -1 = Gauche, 0 = Milieu, 1 = Droite
        const laneWidth = 3;

        init();
        animate();

        function init() {
            // 1. Scène et Caméra
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x1a0933); // Ambiance nuit/cyberpunk
            scene.fog = new THREE.FogExp2(0x1a0933, 0.015);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 5, 10);
            camera.lookAt(0, 2, -10);

            // 2. Rendu
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.shadowMap.enabled = true;
            document.body.appendChild(renderer.domElement);

            // 3. Lumières
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffcc00, 0.8);
            dirLight.position.set(10, 20, 10);
            scene.add(dirLight);

            // 4. La Route
            const roadGeo = new THREE.PlaneGeometry(10, 100);
            const roadMat = new THREE.MeshStandardMaterial({ color: 0x151515, roughness: 0.8 });
            
            road = new THREE.Mesh(roadGeo, roadMat);
            road.rotation.x = -Math.PI / 2;
            road.position.z = 0;
            scene.add(road);

            road2 = road.clone();
            road2.position.z = -100;
            scene.add(road2);

            createRoadLines();

            // 5. Le Taxi
            const taxiGroup = new THREE.Group();
            
            const bodyGeo = new THREE.BoxGeometry(1.5, 0.6, 3);
            const bodyMat = new THREE.MeshStandardMaterial({ color: 0xffcc00 }); 
            const body = new THREE.Mesh(bodyGeo, bodyMat);
            body.position.y = 0.4;
            taxiGroup.add(body);

            const cabinGeo = new THREE.BoxGeometry(1.3, 0.5, 1.6);
            const cabinMat = new THREE.MeshStandardMaterial({ color: 0x222222 });
            const cabin = new THREE.Mesh(cabinGeo, cabinMat);
            cabin.position.set(0, 0.95, -0.2);
            taxiGroup.add(cabin);

            const signGeo = new THREE.BoxGeometry(0.5, 0.2, 0.2);
            const signMat = new THREE.MeshStandardMaterial({ color: 0xffffff });
            const sign = new THREE.Mesh(signGeo, signMat);
            sign.position.set(0, 1.3, -0.2);
            taxiGroup.add(sign);

            taxi = taxiGroup;
            scene.add(taxi);

            // 6. Commandes clavier
            window.addEventListener('keydown', (e) => {
                if (gameOver) return;
                if (e.key === 'ArrowLeft' && targetLane > -1) targetLane--;
                if (e.key === 'ArrowRight' && targetLane < 1) targetLane++;
            });

            window.addEventListener('resize', onWindowResize);
        }

        function createRoadLines() {
            for (let z = 0; z > -200; z -= 10) {
                const lineGeo = new THREE.PlaneGeometry(0.1, 4);
                const lineMat = new THREE.MeshBasicMaterial({ color: 0x00ffff }); // Lignes néons bleues
                
                const line1 = new THREE.Mesh(lineGeo, lineMat);
                line1.rotation.x = -Math.PI/2;
                line1.position.set(-1.6, 0.01, z);
                scene.add(line1);

                const line2 = line1.clone();
                line2.position.x = 1.6;
                scene.add(line2);
            }
        }

        function spawnEntities() {
            if (Math.random() > 0.04) return;

            const lanes = [-laneWidth, 0, laneWidth];
            const randomLane = lanes[Math.floor(Math.random() * lanes.length)];
            
            // Vérifier l'espace sur la voie choisie
            for(let obs of obstacles) { if (obs.position.x === randomLane && obs.position.z > -40) return; }
            for(let cust of customers) { if (cust.position.x === randomLane && cust.position.z > -40) return; }

            // 80% de chance de spawn une voiture ennemie, 20% un client
            if (Math.random() > 0.2) {
                // Ennemi
                const obsGroup = new THREE.Group();
                const colors = [0xff3333, 0x3333ff, 0xff00ff];
                const bodyMat = new THREE.MeshStandardMaterial({ color: colors[Math.floor(Math.random() * colors.length)] });
                const body = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.6, 2.8), bodyMat);
                body.position.y = 0.4;
                obsGroup.add(body);
                obsGroup.position.set(randomLane, 0, -80);
                scene.add(obsGroup);
                obstacles.push(obsGroup);
            } else {
                // Client à ramasser (Tore lumineux)
                const custGeo = new THREE.TorusGeometry(0.6, 0.15, 8, 24);
                const custMat = new THREE.MeshBasicMaterial({ color: 0x39ff14 }); // Vert fluo
                const customer = new THREE.Mesh(custGeo, custMat);
                customer.position.set(randomLane, 0.8, -80);
                scene.add(customer);
                customers.push(customer);
            }
        }

        function animate() {
            requestAnimationFrame(animate);

            if (!gameOver) {
                // Défilement infini de la route
                road.position.z += speed;
                road2.position.z += speed;
                if (road.position.z >= 50) road.position.z = road2.position.z - 100;
                if (road2.position.z >= 50) road2.position.z = road.position.z - 100;

                // Mouvement latéral fluide du taxi
                const targetX = targetLane * laneWidth;
                taxi.position.x += (targetX - taxi.position.x) * 0.2;

                spawnEntities();

                // Gestion des voitures ennemies (Collisions destructrices)
                for (let i = obstacles.length - 1; i >= 0; i--) {
                    obstacles[i].position.z += speed * 0.4;
                    if (Math.abs(obstacles[i].position.z - taxi.position.z) < 2.5 &&
                        Math.abs(obstacles[i].position.x - taxi.position.x) < 1.2) {
                        endGame();
                    }
                    if (obstacles[i].position.z > 15) {
                        scene.remove(obstacles[i]);
                        obstacles.splice(i, 1);
                        score += 10;
                        document.getElementById('score').innerText = score;
                        speed += 0.005; // Accélération progressive
                    }
                }

                // Gestion des clients (Ramassage bonus)
                for (let i = customers.length - 1; i >= 0; i--) {
                    customers[i].position.z += speed; // Les clients défilent au rythme du décor
                    customers[i].rotation.y += 0.05;   // Rotation sur lui-même

                    // Détection du ramassage
                    if (Math.abs(customers[i].position.z - taxi.position.z) < 1.8 &&
                        Math.abs(customers[i].position.x - taxi.position.x) < 1.2) {
                        scene.remove(customers[i]);
                        customers.splice(i, 1);
                        score += 50; // Gros bonus !
                        document.getElementById('score').innerText = score;
                        continue;
                    }

                    if (customers[i].position.z > 15) {
                        scene.remove(customers[i]);
                        customers.splice(i, 1);
                    }
                }
            }

            renderer.render(scene, camera);
        }

        function endGame() {
            gameOver = true;
            document.getElementById('gameover').style.display = 'block';
        }

        function resetGame() {
            for (let obs of obstacles) scene.remove(obs);
            for (let cust of customers) scene.remove(cust);
            obstacles = [];
            customers = [];
            score = 0;
            speed = 0.8;
            targetLane = 0;
            taxi.position.set(0, 0, 0);
            document.getElementById('score').innerText = score;
            document.getElementById('gameover').style.display = 'none';
            gameOver = false;
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }
